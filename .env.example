# Copie para .env.local (Vite só lê .env* na raiz do frontend) e ajuste.

# Uso local na mesma rede WiFi (padrão): NÃO defina nada aqui — o app já
# assume que o backend está no mesmo host da página, na porta 8000.

# Deploy (frontend na Vercel + backend hospedado à parte, ex. Railway/Render):
# URL completa e pública do backend, com https:// (a Vercel serve por https,
# então o navegador bloqueia chamar http:// simples — "mixed content").
VITE_API_BASE_URL=https://seu-backend.exemplo.com

# Alternativa mais restrita: mantém a montagem host:8000, só troca o host
# (útil quando o backend está em outra máquina da MESMA rede local, não em
# deploy público). Ignorado se VITE_API_BASE_URL estiver definido.
VITE_BACKEND_HOST=
